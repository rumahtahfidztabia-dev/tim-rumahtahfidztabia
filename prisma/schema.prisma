generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String     @id @default(uuid())
  name         String
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(EDITOR)
  avatarUrl    String?
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Activity     Activity[]
  Article      Article[]
  Donation     Donation[]

  // relasi ke tabel baru Tabia Ops
  tasksAssigned     Task[]        @relation("AssignedTo")
  tasksCreated      Task[]        @relation("CreatedBy")
  kpiEntries        KpiEntry[]
  wikiPagesAuthored WikiPage[]

  @@map("AdminUser")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AboutUs {
  id            String   @id
  heroImage     String?
  foundedYear   Int      @default(2009)
  history       String
  visionMission String
  youtubeUrl    String?
  legalityText  String?
  legalityFiles String[]
  mapsEmbedUrl  String?
  updatedAt     DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Activity {
  id              String          @id
  slug            String          @unique
  title           String
  description     String
  eventDate       DateTime?
  metaTitle       String?
  metaDescription String?
  categoryId      String?
  authorId        String?
  isPublished     Boolean         @default(false)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  AdminUser       AdminUser?      @relation(fields: [authorId], references: [id])
  Category        Category?       @relation(fields: [categoryId], references: [id])
  ActivityMedia   ActivityMedia[]
  ActivityTag     ActivityTag[]

  @@index([isPublished, publishedAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ActivityBannerImage {
  id        String   @id
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ActivityMedia {
  id         String    @id
  activityId String
  type       MediaType
  imageUrl   String?
  youtubeUrl String?
  caption    String?
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  Activity   Activity  @relation(fields: [activityId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ActivityTag {
  activityId String
  tagId      String
  Activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  Tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Article {
  id              String       @id
  slug            String       @unique
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  categoryId      String?
  authorId        String?
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  AdminUser       AdminUser?   @relation(fields: [authorId], references: [id])
  Category        Category?    @relation(fields: [categoryId], references: [id])
  ArticleTag      ArticleTag[]

  @@index([isPublished, publishedAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ArticleTag {
  articleId String
  tagId     String
  Article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  Tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Campaign {
  id              String        @id
  slug            String        @unique
  title           String
  description     String
  coverImage      String?
  targetAmount    Decimal       @db.Decimal(14, 2)
  collectedAmount Decimal       @default(0) @db.Decimal(14, 2)
  deadline        DateTime?
  isPinned        Boolean       @default(false)
  isActive        Boolean       @default(true)
  categoryId      String?
  shareMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  Category        Category?     @relation(fields: [categoryId], references: [id])
  CampaignTag     CampaignTag[]
  Donation        Donation[]

  @@index([isPinned, isActive])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CampaignTag {
  campaignId String
  tagId      String
  Campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  Tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Category {
  id       String       @id
  slug     String
  name     String
  type     CategoryType @default(ARTICLE)
  Activity Activity[]
  Article  Article[]
  Campaign Campaign[]

  @@unique([slug, type])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ContactMessage {
  id        String   @id
  name      String
  contact   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CrowdfundingPartner {
  id           String   @id
  logoUrl      String
  platformName String
  campaignUrl  String
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Donation {
  id                    String         @id
  campaignId            String?
  donorId               String
  amount                Decimal        @db.Decimal(14, 2)
  isAnonymousPublic     Boolean        @default(false)
  status                DonationStatus @default(PENDING)
  paymentMethod         PaymentMethod  @default(QRIS)
  qrisPayload           String?
  confirmedAt           DateTime?
  verifiedAt            DateTime?
  verifiedById          String?
  prayer                String?
  adminNote             String?
  snapToken             String?
  midtransTransactionId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  Campaign              Campaign?      @relation(fields: [campaignId], references: [id])
  Donor                 Donor          @relation(fields: [donorId], references: [id])
  AdminUser             AdminUser?     @relation(fields: [verifiedById], references: [id])

  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DonationReport {
  id          String   @id
  title       String
  periodStart DateTime
  periodEnd   DateTime
  summary     String
  fileUrl     String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Donor {
  id             String        @id
  name           String
  contact        String        @unique
  contactType    String
  category       DonorCategory @default(PROSPEK)
  totalDonations Int           @default(0)
  lastDonationAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Donation       Donation[]
  DonorNote      DonorNote[]

  @@index([category])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DonorNote {
  id        String   @id
  donorId   String
  note      String
  createdAt DateTime @default(now())
  Donor     Donor    @relation(fields: [donorId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FooterSetting {
  id            String   @id
  socialLinks   Json?
  footerMenu    Json?
  copyrightText String?
  updatedAt     DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model HeroSetting {
  id               String   @id
